# bootstrap.py fills in everything below except GITHUB_TOKEN.
POSTGRES_PASSWORD=
DD_DB_PASSWORD=
SONAR_DB_PASSWORD=
DEVLAKE_DB_PASSWORD=
DD_SECRET_KEY=
DD_CREDENTIAL_AES_256_KEY=
DD_ADMIN_PASSWORD=
SONAR_ADMIN_PASSWORD=
DEVLAKE_ENCRYPTION_SECRET=
DEVLAKE_GRAFANA_PASSWORD=
DD_API_TOKEN=
SONAR_TOKEN=

# For devlake.py: fine-grained, read-only (metadata, contents, pull requests, issues, actions).
GITHUB_TOKEN=

# Optional, for web.py --auth: a header every web scanner sends to scan logged in.
# Use a dedicated test account: log in as it and copy the session cookie
# (DevTools > Application > Cookies), e.g. WEB_AUTH_HEADER=Cookie: session=...
WEB_AUTH_HEADER=
# Optional, for osint.py --domain: haveibeenpwned.com API key (paid tier) with the domain verified.
HIBP_API_KEY=
